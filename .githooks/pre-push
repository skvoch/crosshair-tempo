#!/bin/sh
# Refresh the README UI screenshot before publishing a branch.
set -eu

if [ -n "${CROSSHAIR_TEMPO_PYTHON:-}" ]; then
    "$CROSSHAIR_TEMPO_PYTHON" scripts/capture_ui_screenshot.py
elif command -v py >/dev/null 2>&1; then
    py -3 scripts/capture_ui_screenshot.py
elif command -v python >/dev/null 2>&1; then
    python scripts/capture_ui_screenshot.py
else
    python3 scripts/capture_ui_screenshot.py
fi

if ! git diff --quiet -- assets/crosshair-customisation.png; then
    echo >&2 "Crosshair screenshot was refreshed. Commit assets/crosshair-customisation.png, then push again."
    exit 1
fi
